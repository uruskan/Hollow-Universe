<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Hollow.Tests</RootNamespace>
    <!-- Match the dedicated server. One test process must not reserve a server-GC heap per CPU while
         the editor and hosted game share a workstation. This changes collection policy, not test coverage. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Hollow.Core/Hollow.Core.csproj" />
    <ProjectReference Include="../../src/Hollow.Galaxy/Hollow.Galaxy.csproj" />
    <ProjectReference Include="../../src/Hollow.Surface/Hollow.Surface.csproj" />
    <ProjectReference Include="../../src/Hollow.Simulation/Hollow.Simulation.csproj" />
    <ProjectReference Include="../../src/Hollow.Net/Hollow.Net.csproj" />
    <ProjectReference Include="../../src/Hollow.Persistence/Hollow.Persistence.csproj" />
    <ProjectReference Include="../../src/Hollow.Client/Hollow.Client.csproj" />
    <ProjectReference Include="../../src/Hollow.Server/Hollow.Server.csproj" />
    <ProjectReference Include="../../tools/Hollow.NetGen/Hollow.NetGen.csproj" />
    <ProjectReference Include="../../tools/Hollow.Bots/Hollow.Bots.csproj" />
  </ItemGroup>
</Project>
