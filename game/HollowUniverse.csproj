<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>HollowUniverse</RootNamespace>
    <!-- Godot runs the Debug build: the game's own work (the air's tables, the flora's painting, the impostors' atlas,
         the warm-up) is optimized there too, as Hollow.Surface's is (GROUND.md §4.3.1). -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Hollow.Core/Hollow.Core.csproj" />
    <ProjectReference Include="../src/Hollow.Galaxy/Hollow.Galaxy.csproj" />
    <ProjectReference Include="../src/Hollow.Surface/Hollow.Surface.csproj" />
    <ProjectReference Include="../src/Hollow.Simulation/Hollow.Simulation.csproj" />
    <ProjectReference Include="../src/Hollow.Client/Hollow.Client.csproj" />
    <ProjectReference Include="../src/Hollow.Server/Hollow.Server.csproj" />
  </ItemGroup>
</Project>
