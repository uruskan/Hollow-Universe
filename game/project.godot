; Engine configuration file.
; Hollow Universe client. Open this folder in Godot 4.7.2 (.NET edition).

config_version=5

[application]

config/name="Hollow Universe"
config/description="Online survival in a full-scale Milky Way."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/loading/splash.png"
boot_splash/stretch_mode=4
boot_splash/use_filter=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="HollowUniverse"
project/solution_directory="../"

[gui]

theme/custom_font="res://assets/fonts/Inter/InterVariable.ttf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

shader_compiler/shader_cache/enabled=true
rendering_device/pipeline_cache/enable=true
environment/defaults/default_clear_color=Color(0.004, 0.006, 0.012, 1)
lights_and_shadows/tighter_shadow_caster_culling=false
anti_aliasing/quality/msaa_3d=1
