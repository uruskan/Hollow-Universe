[remap]

importer="scene"
importer_version=1
type="PackedScene"

[params]

meshes/ensure_tangents=true
meshes/generate_lods=false
meshes/create_shadow_meshes=true
meshes/light_baking=1
animation/import=false
gltf/embedded_image_handling=0
_subresources={
"materials": {
"Building_metal": {
"use_external/enabled": true,
"use_external/fallback_path": "res://assets/materials/building_metal.tres",
"use_external/path": "res://assets/materials/building_metal.tres"
}
}
}
