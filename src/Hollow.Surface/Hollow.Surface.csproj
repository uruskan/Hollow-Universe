<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Hollow.Surface</RootNamespace>
    <!-- Surfaces are generated while the game streams them, also in Debug builds (the game runs Debug). -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hollow.Core/Hollow.Core.csproj" />
    <ProjectReference Include="../Hollow.Galaxy/Hollow.Galaxy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hollow.Tests" />
    <InternalsVisibleTo Include="Hollow.GeneratorReport" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data/cliffs.json" />
    <EmbeddedResource Include="Data/monuments.json" />
  </ItemGroup>
</Project>
