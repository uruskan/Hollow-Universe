<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A console program, and a library the game hosts in-process for solo play (GROUND.md §4.2). -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Hollow.Server</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hollow.Core/Hollow.Core.csproj" />
    <ProjectReference Include="../Hollow.Galaxy/Hollow.Galaxy.csproj" />
    <ProjectReference Include="../Hollow.Surface/Hollow.Surface.csproj" />
    <ProjectReference Include="../Hollow.Simulation/Hollow.Simulation.csproj" />
    <ProjectReference Include="../Hollow.Net/Hollow.Net.csproj" />
    <ProjectReference Include="../Hollow.Persistence/Hollow.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hollow.Tests" />
  </ItemGroup>
</Project>
