<?xml version="1.0" encoding="utf-8"?>
<!--
  Third-party packages are vendored in third_party/packages so the repository builds without network access
  (ARCHITECTURE.md §5). Source mapping sends those package IDs to the local folder only; everything else (the
  Godot SDK packages) resolves as before, from the global packages folder or the user's own sources.
-->
<configuration>
  <packageSources>
    <add key="hollow-third-party" value="third_party/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="hollow-third-party">
      <package pattern="LiteNetLib" />
      <package pattern="JoltPhysicsSharp" />
      <package pattern="JoltPhysics.Native" />
      <package pattern="Microsoft.Data.Sqlite" />
      <package pattern="Microsoft.Data.Sqlite.Core" />
      <package pattern="SQLitePCLRaw.*" />
      <package pattern="System.Memory" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
