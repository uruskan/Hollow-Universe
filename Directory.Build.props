<Project>
  <!-- Shared settings for every C# project in the repository, including the Godot client. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Packages are vendored (third_party/, NuGet.config); the vulnerability audit would need nuget.org. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
